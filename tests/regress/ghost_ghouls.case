# A ghost outside Khumash-Gor's tomb now and then makes a threatening
# gesture instead of throwing a skull, and calls ghouls out of the ground
# (Khumash-Gor himself never does)
args: --cheat
do: t10;spawn:411,300;t1200;find:142
# (where the ghouls end up depends on the course of the fight)
expect: id    63 shape  142 frame
expect: npc 63 map 3
