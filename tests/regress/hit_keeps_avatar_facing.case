# The Avatar hit from behind in a fight while the player steers him keeps facing his way and stays where he is (he snapped round to the blow, away from the enemy he fought)
args: --map 39 --pos 16454,13798,48
do: t5;combat;t20;where:1;hit:1,3,1;t2;where:1;t30;where:1
expect: where 1: 16454,13798,48 shape 1 frame 804 dir 0
expect: where 1: 16454,13798,48 shape 1 frame 330 dir 0
reject: dir 4
