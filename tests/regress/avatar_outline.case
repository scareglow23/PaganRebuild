# Option "outline when hidden": behind a wall of the Upper Catacombs the Avatar
# shows as an outline, but only once he has been hidden for a moment (walking
# past a pillar it would come and go)
args: --map 50 --pos 5859,2314,48
do: option:map_fade,off;option:avatar_outline,on;t5;outline;t15;outline
expect: outline: 0 pixels
expect: outline: 784 pixels
